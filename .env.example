# Desenvolvimento local — copie para .env na raiz do repo.
# Produção usa docker/.env (template em docker/.env.example).

PRODUCTION=false
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=debug
VITE_LOG_LEVEL=debug
DATA_DIR=./data

# gere com: openssl rand -hex 32 ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64-hex-chars>
SESSION_MAX_DURATION_DAYS=30

DEV_VIEWER_PORT=5173

DOMAIN=localhost
DISCORD_CLIENT_ID=<discord-client-id>
DISCORD_CLIENT_SECRET=<discord-client-secret>
LIVEKIT_TOKEN_TTL_SEC=86400

LIVEKIT_URL=ws://localhost:7880
# devkey/secret são os defaults do modo --dev do livekit-server.
# Só precisam bater com a instância que você usa — em produção
# gere com: openssl rand -hex 16 ou node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LIVEKIT_API_KEY=devkey
# gere com: openssl rand -hex 16 ou node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LIVEKIT_API_SECRET=secret
LIVEKIT_DEV_PORT=7880
# Opcional: path de um binário livekit-server local para o dev subir sozinho.
# Vazio = o dev assume um LiveKit externo em LIVEKIT_DEV_PORT (ver README §LiveKit local).
LIVEKIT_DEV_BIN=

ROOM_EMPTY_TIMEOUT_SEC=10
