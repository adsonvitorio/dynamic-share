# ---- Core ----
PRODUCTION=true
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
VITE_LOG_LEVEL=warn
DATA_DIR=/app/data

# ---- Sessão (cookie cifrado; sem banco de dados) ----
# gere com: openssl rand -hex 32 ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<64-hex-chars>
SESSION_MAX_DURATION_DAYS=30

# ---- Aplicação ----
DOMAIN=<app.example.com>
DISCORD_CLIENT_ID=<discord-client-id>
DISCORD_CLIENT_SECRET=<discord-client-secret>
LIVEKIT_TOKEN_TTL_SEC=86400

# ---- LiveKit ----
# API_KEY/SECRET são um par de credenciais que VOCÊ inventa — não vêm de
# nenhum serviço externo. O compose injeta ambos no livekit.yaml e no
# server; qualquer string forte serve.
LIVEKIT_URL=ws://livekit:7880
# gere com: openssl rand -hex 16 ou node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LIVEKIT_API_KEY=<livekit-api-key>
# gere com: openssl rand -hex 16 ou node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
LIVEKIT_API_SECRET=<livekit-api-secret>
ROOM_EMPTY_TIMEOUT_SEC=10

# ---- Caddy / TLS ----
CADDY_EMAIL=<email@example.com>
CF_API_TOKEN=<cloudflare-dns-token>
