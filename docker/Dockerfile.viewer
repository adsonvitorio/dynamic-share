FROM node:22-alpine AS build
WORKDIR /repo
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/viewer/package.json packages/viewer/
COPY packages/server/package.json packages/server/
RUN npm ci --workspace @share/shared --workspace @share/viewer --include-workspace-root=false
COPY packages/shared packages/shared
COPY packages/viewer packages/viewer
ARG VITE_LOG_LEVEL=warn
ENV VITE_LOG_LEVEL=$VITE_LOG_LEVEL
RUN npm run build --workspace @share/shared \
 && npm run build --workspace @share/viewer

FROM nginx:1.27-alpine
RUN chown -R nginx:nginx /var/cache/nginx
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /repo/packages/viewer/build /usr/share/nginx/html
USER nginx
EXPOSE 8080
